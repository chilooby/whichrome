#!/usr/bin/env bash
# Whichrome launcher. Plugin installs add bin/ to PATH; this finds a real Python.
here="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
for c in python3 python py; do
  p="$(command -v "$c" 2>/dev/null || true)"
  [ -n "$p" ] || continue
  if "$p" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 9) else 1)' >/dev/null 2>&1; then
    exec "$p" "$here/whichrome.py" "$@"
  fi
done
echo "whichrome: needs Python 3.9+ on PATH (tried python3, python, py)." >&2
exit 1
